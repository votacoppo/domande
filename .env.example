# URL pubblico esatto, senza slash finale.
SITE_URL=http://localhost:3000

# Piattaforma che aggiunge l'IP affidabile: netlify, vercel oppure local.
DEPLOY_PLATFORM=local

# Supabase: la chiave server non deve mai avere prefisso NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile. In produzione entrambi sono obbligatori.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=localhost

# Accesso alla sola dashboard Domande.
ADMIN_EMAIL=votacoppodomande@gmail.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_EPOCH=1

# HMAC per rendere non reversibile l'IP usato dal rate limit.
IP_HASH_SECRET=

# Informativa confermata per il progetto Coppo.
DATA_CONTROLLER_NAME="Marcello Coppo"
DATA_CONTROLLER_CONTACT="votacoppo@gmail.com"
DATA_PROCESSING_LEGAL_BASIS="Consenso dell'interessato ai sensi dell'art. 6, par. 1, lett. a) GDPR"
DATA_HOSTING_PROVIDER="Vercel per l'hosting, Supabase per il database e Cloudflare Turnstile per l'anti-spam"
DATA_RETENTION_POLICY="Domande e archivi vengono eliminati automaticamente da Supabase entro 30 giorni; gli identificatori tecnici usati per il rate limit entro 2 giorni. Il titolare può cancellare prima i dati dalla dashboard."
